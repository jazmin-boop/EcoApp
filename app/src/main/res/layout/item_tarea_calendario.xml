<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FAF8F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Avatar circular con fondo neutro claro -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:cardCornerRadius="25dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#EAEAEA">
            <ImageView
                android:id="@+id/ivIconoTarea"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:src="@drawable/planta"
                android:contentDescription="Icono de Tarea" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Información de la Planta y Tipo de Tarea -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tvNombrePlantaCal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monstera"
                android:textColor="#2E7D32"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTipoTareaCal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Regar planta"
                android:textColor="#C2185B"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Icono de reloj estilo plantilla -->
        <TextView
            android:id="@+id/btnRelojAlarma"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_search"
            android:backgroundTint="#FCE4EC"
            android:gravity="center"
            android:text="⏰"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="12dp" />

        <CheckBox
            android:id="@+id/cbHecho"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#2E7D32" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>