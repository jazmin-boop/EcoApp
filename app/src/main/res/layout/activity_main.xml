<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F6F0">

    <!-- Contenido Principal Desplazable (Plantilla Larga) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="90dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Barra Superior: Título "Mi Huerto" y Corazón (Ubicados más abajo, no pegados al borde) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvMainTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Mi Huerto"
                    android:textColor="#222222"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Icono de Corazón de Favoritos -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnMainFavorites"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <ImageView
                        android:id="@+id/ivMainHeart"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_heart_filled"
                        android:contentDescription="Favoritos" />
                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>

            <!-- 1. Tarjeta Clima + Calendario con Avión de Papel (Open-Meteo REST API) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FAF8F5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <!-- Desplegable de Ciudad con el Avioncito de Papel de la Plantilla -->
                        <LinearLayout
                            android:id="@+id/btnSelectRegion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_search"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:clickable="true"
                            android:focusable="true">

                            <TextView
                                android:id="@+id/tvMainRegion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lima, Perú"
                                android:textColor="#222222"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <!-- Icono de Avión de Papel / Flecha de la plantilla -->
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_paper_plane"
                                android:layout_marginStart="6dp"
                                android:contentDescription="Ubicación" />
                        </LinearLayout>

                        <!-- Temperatura y Sol -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvMainTemp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="29°"
                                android:textColor="#222222"
                                android:textSize="28sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_light"
                                android:layout_marginStart="6dp"
                                android:contentDescription="Sol" />

                            <TextView
                                android:id="@+id/tvMainRainProb"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lluvia: 15%"
                                android:textColor="#666666"
                                android:textSize="10sp"
                                android:layout_marginStart="6dp" />
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- Franja de Días del Mes -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:weightSum="8">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.5"
                            android:text="Agosto"
                            android:textColor="#2E7D32"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <!-- Día 14 -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:text="Lu" android:textSize="10sp" android:textColor="#666666" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="14" android:textSize="13sp" android:textColor="#222222" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <!-- Día 15 (Seleccionado en rosa) -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:background="#F8BBD0" android:paddingVertical="4dp">
                            <TextView android:text="Ma" android:textSize="10sp" android:textColor="#C2185B" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="15" android:textSize="13sp" android:textColor="#C2185B" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <!-- Día 16 -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:text="Mi" android:textSize="10sp" android:textColor="#666666" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="16" android:textSize="13sp" android:textColor="#222222" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <!-- Día 17 -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:text="Ju" android:textSize="10sp" android:textColor="#666666" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="17" android:textSize="13sp" android:textColor="#222222" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <!-- Día 18 -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:text="Vi" android:textSize="10sp" android:textColor="#666666" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="18" android:textSize="13sp" android:textColor="#222222" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <!-- Día 19 -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:text="Sa" android:textSize="10sp" android:textColor="#2E7D32" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="19" android:textSize="13sp" android:textColor="#2E7D32" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <!-- Día 20 -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                            <TextView android:text="Do" android:textSize="10sp" android:textColor="#2E7D32" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                            <TextView android:text="20" android:textSize="13sp" android:textColor="#2E7D32" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Botón Toggle (Hoy / Próximas) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_search"
                android:gravity="center_vertical"
                android:padding="4dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/btnToggleHoy"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_filter_btn"
                    android:gravity="center"
                    android:text="Hoy"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnToggleProximas"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Próximas"
                    android:textColor="#2E7D32"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Completa o pospone las tareas tocando sobre ellas."
                android:textColor="#666666"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvTotalTareasMain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_search"
                android:backgroundTint="#F8BBD0"
                android:text=" 0 tareas "
                android:textColor="#C2185B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_marginBottom="16dp" />

            <!-- RECYCLERVIEW DINÁMICO DE TAREAS (Sustituye hardcoded) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMainTareas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="24dp" />

            <!-- Sección Final: Mi Huerto con Fotos Circulares mediante URL -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E2EFE0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mi Huerto"
                        android:textColor="#164639"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <!-- Cuadrícula 2x3 de Plantas del Huerto con Fotos Circulares -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="3"
                        android:rowCount="2"
                        android:layout_marginBottom="20dp">

                        <!-- Planta 1: Monstera -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginBottom="16dp">
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                app:cardCornerRadius="35dp"
                                app:cardElevation="0dp">
                                <ImageView
                                    android:id="@+id/ivGardenMonstera"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/helecho"
                                    android:contentDescription="Monstera"/>
                            </com.google.android.material.card.MaterialCardView>
                            <TextView android:text="Monstera" android:textColor="#222222" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <!-- Planta 2: Sansevieria -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginBottom="16dp">
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                app:cardCornerRadius="35dp"
                                app:cardElevation="0dp">
                                <ImageView
                                    android:id="@+id/ivGardenSansevieria"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/suculenta"
                                    android:contentDescription="Sansevieria"/>
                            </com.google.android.material.card.MaterialCardView>
                            <TextView android:text="Sansevieria" android:textColor="#222222" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <!-- Planta 3: Orquídea -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_marginBottom="16dp">
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                app:cardCornerRadius="35dp"
                                app:cardElevation="0dp">
                                <ImageView
                                    android:id="@+id/ivGardenOrchid"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/helecho"
                                    android:contentDescription="Orquídea"/>
                            </com.google.android.material.card.MaterialCardView>
                            <TextView android:text="Orquídea" android:textColor="#222222" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <!-- Planta 4: Potus -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                app:cardCornerRadius="35dp"
                                app:cardElevation="0dp">
                                <ImageView
                                    android:id="@+id/ivGardenPothos"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/suculenta"
                                    android:contentDescription="Potus Dorado"/>
                            </com.google.android.material.card.MaterialCardView>
                            <TextView android:text="Potus Dorado" android:textColor="#222222" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <!-- Planta 5: Lirio -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                app:cardCornerRadius="35dp"
                                app:cardElevation="0dp">
                                <ImageView
                                    android:id="@+id/ivGardenPeaceLily"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/suculenta"
                                    android:contentDescription="Lirio de la Paz"/>
                            </com.google.android.material.card.MaterialCardView>
                            <TextView android:text="Lirio de Paz" android:textColor="#222222" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>

                        <!-- Planta 6: Ficus -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="70dp"
                                android:layout_height="70dp"
                                app:cardCornerRadius="35dp"
                                app:cardElevation="0dp">
                                <ImageView
                                    android:id="@+id/ivGardenFicus"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/helecho"
                                    android:contentDescription="Ficus"/>
                            </com.google.android.material.card.MaterialCardView>
                            <TextView android:text="Ficus" android:textColor="#222222" android:textSize="12sp" android:textStyle="bold" android:layout_marginTop="6dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </GridLayout>

                    <!-- Botón Ir a mi huerto -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnGoToGarden"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_btn_dark"
                        android:text="Ir a mi huerto"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Contenedor flotante para la barra de navegación inferior y el botón FAB -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBottomNav"
            android:layout_width="0dp"
            android:layout_height="70dp"
            app:cardCornerRadius="35dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:weightSum="4"
                android:paddingHorizontal="8dp">

                <!-- 1. Home -->
                <LinearLayout
                    android:id="@+id/navHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_nav_active"
                    android:paddingVertical="4dp">
                    <ImageView
                        android:id="@+id/ivHome"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_home"
                        app:tint="#2E7D32"
                        android:contentDescription="Home"/>
                    <TextView
                        android:id="@+id/tvHome"
                        android:text="Home"
                        android:textSize="10sp"
                        android:textColor="#2E7D32"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- 2. Plantas -->
                <LinearLayout
                    android:id="@+id/navPlantas"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="4dp">
                    <ImageView
                        android:id="@+id/ivPlantas"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_plant_vector"
                        app:tint="#222222"
                        android:contentDescription="Plantas"/>
                    <TextView
                        android:id="@+id/tvPlantas"
                        android:text="Plantas"
                        android:textSize="10sp"
                        android:textColor="#222222"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- 3. Calendario -->
                <LinearLayout
                    android:id="@+id/navCalendario"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="4dp">
                    <ImageView
                        android:id="@+id/ivCalendario"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_calendar_vector"
                        app:tint="#222222"
                        android:contentDescription="Calendario"/>
                    <TextView
                        android:id="@+id/tvCalendario"
                        android:text="Calendario"
                        android:textSize="10sp"
                        android:textColor="#222222"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- 4. Reportes -->
                <LinearLayout
                    android:id="@+id/navReportes"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="4dp">
                    <ImageView
                        android:id="@+id/ivReportes"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_reports"
                        app:tint="#222222"
                        android:contentDescription="Reportes"/>
                    <TextView
                        android:id="@+id/tvReportes"
                        android:text="Reportes"
                        android:textSize="10sp"
                        android:textColor="#222222"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>