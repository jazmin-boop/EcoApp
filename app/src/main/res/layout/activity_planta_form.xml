<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F6F0">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="40dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Barra Superior: Flecha y Título ubicados más abajo -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:id="@+id/ivBackForm"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_search"
                    android:padding="8dp"
                    android:src="@drawable/ic_back"
                    android:contentDescription="Volver" />

                <TextView
                    android:id="@+id/tvFormTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="Registrar Nueva Planta"
                    android:textColor="#164639"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Botón Elegir de la Librería de Alto Contraste -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnChooseFromLibrary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_filter_btn"
                android:text="📖 Elegir de la librería de plantas"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp"/>

            <!-- Contenedor del Formulario con Alto Contraste -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#C8E6C9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Campo 1: Nombre -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nombre de la Planta *"
                        android:textColor="#164639"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etNombre"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_search"
                        android:hint="Ej. Monstera de la Sala"
                        android:paddingHorizontal="16dp"
                        android:textColor="#222222"
                        android:textColorHint="#888888"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"
                        android:autofillHints="name"
                        android:inputType="textPersonName"/>

                    <!-- Campo 2: Especie -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Especie *"
                        android:textColor="#164639"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etEspecie"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_search"
                        android:hint="Ej. Monstera deliciosa"
                        android:paddingHorizontal="16dp"
                        android:textColor="#222222"
                        android:textColorHint="#888888"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"
                        android:autofillHints="name"
                        android:inputType="text"/>

                    <!-- Campo 3: Fecha de Siembra -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fecha de Siembra *"
                        android:textColor="#164639"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etFechaSiembra"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_search"
                        android:hint="DD/MM/YYYY"
                        android:paddingHorizontal="16dp"
                        android:textColor="#222222"
                        android:textColorHint="#888888"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"
                        android:autofillHints="date"
                        android:inputType="date"/>

                    <!-- Campo 4: Frecuencia de Riego -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Frecuencia de Riego (Días) *"
                        android:textColor="#164639"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etFrecuencia"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_search"
                        android:hint="Ej. 7"
                        android:paddingHorizontal="16dp"
                        android:textColor="#222222"
                        android:textColorHint="#888888"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"
                        android:inputType="number"/>

                    <!-- Campo 5: Ubicación -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ubicación *"
                        android:textColor="#164639"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <RadioGroup
                        android:id="@+id/rgUbicacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <RadioButton
                            android:id="@+id/rbInterior"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Interior"
                            android:checked="true"
                            android:textColor="#164639"
                            android:textStyle="bold"
                            android:buttonTint="#2E7D32"
                            android:layout_marginEnd="24dp"/>

                        <RadioButton
                            android:id="@+id/rbExterior"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Exterior"
                            android:textColor="#164639"
                            android:textStyle="bold"
                            android:buttonTint="#2E7D32"/>
                    </RadioGroup>

                    <!-- Campo 6: Notas -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notas (Opcional)"
                        android:textColor="#164639"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etNotas"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_search"
                        android:hint="Ej. Poner abono orgánico cada mes"
                        android:padding="12dp"
                        android:gravity="top|start"
                        android:textColor="#222222"
                        android:textColorHint="#888888"
                        android:textSize="14sp"
                        android:inputType="textMultiLine"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Botón Guardar con Verde Oscuro -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSavePlant"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_btn_dark"
                android:text="Guardar Planta"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>